# ============================================================================
# MATS — Multi-Agent Trading System environment template
# Copy to `.env` and fill in. Never commit `.env`.
# ============================================================================

# ---------- Execution mode --------------------------------------------------
# Set to 1 to place real orders. Default 0 (paper trading).
MATS_LIVE=0
MATS_TIER=1
MATS_SESSION_ID=default

# ---------- LLM plane -------------------------------------------------------
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=127.0.0.1:11434
LITELLM_PROXY_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-mats-local

# ---------- Obsidian vault --------------------------------------------------
OBSIDIAN_VAULT_PATH=./vault
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124

# ---------- Coinbase Advanced Trade ----------------------------------------
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PORTFOLIO_ID=
COINBASE_SANDBOX=1

# ---------- Base L2 (EVM) ---------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
BASE_WALLET_PRIVATE_KEY=
BASE_REWARD_WALLET=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ---------- Wasabi Protocol (perps on Base) --------------------------------
WASABI_POOL_ADDRESS=
WASABI_ORDERBOOK_URL=https://api.wasabi.xyz/orderbook

# ---------- PredictBase (prediction markets on Base) -----------------------
PREDICTBASE_API_URL=https://api.predictbase.xyz
PREDICTBASE_FACTORY_ADDRESS=

# ---------- Allora (decentralized ML network) ------------------------------
ALLORA_RPC_URL=https://rpc.allora.network
ALLORA_WORKER_KEY=
ALLORA_TOPIC_IDS=1,2,3
ALLORA_CHAIN_ID=allora-testnet-1

# ---------- Venice.ai DIEM ---------------------------------------------------
VENICE_API_KEY=
VENICE_DIEM_CONTRACT=
VENICE_SWAP_ROUTER=

# ---------- Tier 2+ (Chroma, embeddings) -----------------------------------
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
EMBEDDING_MODEL=nomic-embed-text

# ---------- Tier 3+ (Redis SCS) --------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Tier 5 (ToolHive / Keycloak / governance) ----------------------
KEYCLOAK_CLIENT_ID=mats
KEYCLOAK_CLIENT_SECRET=
TOOLHIVE_TOKEN=
TEI_MODEL=sentence-transformers/all-MiniLM-L6-v2
POLICY_CHECKPOINT=./mats_data/policy.pt
GOVERNANCE_HASH_SEED=

# ---------- Relay / Perchance -----------------------------------------------
CONDUIT_SHARED_SECRET=rotate-me-weekly
CLOUDFLARE_TUNNEL_TOKEN=
RELAY_PORT=8787
WS_RELAY_PORT=8788
